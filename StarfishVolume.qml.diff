+    function ampGet(path, onJson) {
+        var xhr = new XMLHttpRequest();
+        var seq = ++root.ampSeq;
+        var guard = Qt.createQmlObject('import QtQuick 2.4; Timer { interval: 800 }', root);
+        guard.triggered.connect(function() { xhr.abort(); guard.destroy(); if (seq === root.ampSeq) root.ampOk = false; });
+        xhr.onreadystatechange = function() {
+            if (xhr.readyState !== XMLHttpRequest.DONE || !guard.running)
+                return;
+            guard.stop(); guard.destroy();
+            var j = null;
+            try { j = JSON.parse(xhr.responseText); } catch (e) {}
+            if (xhr.status === 200 && j && j.response_code === 0)
+                onJson(j);
+            else if (seq === root.ampSeq)
+                root.ampOk = false;
+        };
+        xhr.open("GET", "http://" + root.ampHost + "/YamahaExtendedControl/v1/" + path);
+        guard.start();
+        xhr.send();
+    }
+
+    function ampFeatures() {
+        ampGet("system/getFeatures", function(j) {
+            (j.zone || []).forEach(function(z) {
+                if (z.id !== "main") return;
+                (z.range_step || []).forEach(function(r) { if (r.id === "volume" && r.max > 0) root.ampMax = r.max; });
+            });
+        });
+    }
+
+    function ampRefresh() {
+        ampGet("main/getStatus", function(j) {
+            if (j.power !== "on" || typeof j.volume !== "number") { root.ampOk = false; return; }
+            root.ampVolume = j.volume;
+            root.ampMuted = j.mute === true;
+            var av = j.actual_volume;
+            root.ampText = root.ampMuted ? "MUTE" :
+                           (av && av.unit === "dB" && typeof av.value === "number") ? av.value.toFixed(1) + " dB" : j.volume.toString();
+            root.ampOk = true;
+            root.ampBarLength();
+        });
+    }
+
+    function ampBarLength() {
+        if (!ampMode) return;
+        var len = (ampVolume - 1) * Settings.local.volume.barMiddleHeight / (ampMax - 2);
+        root.volumeBarMiddleLength = Math.max(0, Math.min(len, Settings.local.volume.barMiddleHeight));
+    }
+
+    Timer { id: ampFollowUp1; interval: 250; onTriggered: root.ampRefresh() }
+    Timer { id: ampFollowUp2; interval: 700; onTriggered: root.ampRefresh() }
+
+    Component.onCompleted: { ampFeatures(); ampRefresh(); }
