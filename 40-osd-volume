#!/bin/sh
# Shows a Yamaha MusicCast amp's level on the TV's own volume bar (HDMI ARC).
# Bind-mounts /home/root/osd-patch/StarfishVolume.qml over LG's file at boot.
# Skips if /home/root/osd-patch/disable exists, or if LG's file has changed (firmware update).
# Remove: run uninstall.sh, or rm /var/lib/webosbrew/init.d/40-osd-volume and reboot.
F=/usr/lib/qml/WebOSCompositor/views/volume/StarfishVolume.qml
P=/home/root/osd-patch/StarfishVolume.qml
ORIG_MD5=808fd0cd00451235b098876477276ad1
LOG=/tmp/osd-patch.log

[ -f /home/root/osd-patch/disable ] && { echo "$(date) disabled by flag" >> $LOG; exit 0; }
[ -f "$P" ] || exit 0
grep -q " $F " /proc/mounts && exit 0
[ "$(md5sum < "$F" | cut -d' ' -f1)" = "$ORIG_MD5" ] || { echo "$(date) LG file changed, skipping" >> $LOG; exit 0; }

# surface-manager reads the file only when it starts (about 2 s into boot, long before this
# hook), so it needs one restart. Doing that now, while the TV is still starting up and an
# app is on screen (e.g. web-OSome's TV Home), crashes WebAppMgr, which LG answers by
# switching the TV off. So wait in the background for the first standby after boot (screen
# off, LG has closed its apps) and restart it then. If a restart is ever followed by a
# reboot, don't try again until $PEND is deleted.
PEND=/home/root/osd-patch/restart-pending
mount --bind "$P" "$F" || { echo "$(date) mount failed" >> $LOG; exit 0; }
if ! systemctl is-active -q surface-manager-daemon.service; then
  echo "$(date) applied before surface-manager started" >> $LOG
  exit 0
fi
if [ -f "$PEND" ]; then
  echo "$(date) mounted; last restart was followed by a reboot, not restarting (rm $PEND to retry)" >> $LOG
  exit 0
fi
echo "$(date) mounted, will restart surface-manager at the first standby" >> $LOG

luna() { luna-send -n 1 "$1" "$2" </dev/null 2>/dev/null | cat; }
power() { luna luna://com.webos.service.tvpower/power/getPowerState '{}' | sed -n 's/.*"state" *: *"\([^"]*\)".*/\1/p'; }
(
  while :; do
    sleep 5
    [ "$(power)" = "Active Standby" ] || continue
    sleep 5
    [ "$(power)" = "Active Standby" ] || continue
    luna luna://com.webos.applicationManager/running '{}' | grep -q '"id":"net.local.tvhome"' && continue
    touch "$PEND"
    timeout 15 systemctl restart surface-manager-daemon.service
    echo "$(date) in standby: surface-manager restarted (exit $?)" >> $LOG
    break
  done
  # That restart leaves WebAppMgr unable to load the pointer images, so the Magic Remote
  # pointer is invisible in every web app (YouTube, LG's home, TV Home) until a reboot.
  # Restart WebAppMgr too, once it's had time to reconnect, and only while still in standby.
  sleep 10
  until [ "$(power)" = "Active Standby" ]; do sleep 5; done
  timeout 30 systemctl restart webapp-mgr.service
  echo "$(date) in standby: WebAppMgr restarted (exit $?)" >> $LOG
  sleep 300; rm -f "$PEND"   # still up 5 min later: the restarts were fine
  exit 0
) </dev/null >/dev/null 2>&1 &
exit 0
